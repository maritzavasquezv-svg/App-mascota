# Copiar a .env.local y completar
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# --- Solo servidor (se configuran en Vercel, NUNCA en el navegador) ---
ANTHROPIC_API_KEY=
# Modelo del escáner (fotos) y del Consejero (más barato). Límite de IA por persona: al día y al mes.
AI_MODELO_ESCANER=claude-opus-5-5
AI_MODELO_CONSEJERO=claude-sonnet-5-5
AI_LIMITE_DIA=10
AI_LIMITE_MES=150
# (El hottok de Hotmart se guarda en el Panel → Ajustes, no aquí. La clave secreta de Supabase no se usa.)
# Correos con acceso de administración y plan completo (separados por coma)
ADMIN_EMAILS=
# Enlaces de pago de Hotmart (públicos)
NEXT_PUBLIC_HOTMART_PAGO_ANUAL=
NEXT_PUBLIC_HOTMART_PAGO_MENSUAL=
